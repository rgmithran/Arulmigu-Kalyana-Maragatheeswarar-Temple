# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/temple_db
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/temple_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/temple_db

# Client API URL (optional in production when served from same Express server)
# VITE_API_BASE_URL=
